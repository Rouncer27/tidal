---
// @ts-nocheck
import Wrapper from "../../common/shared/Wrapper.astro";
import "./meetUs.scss";
import { Image } from "astro:assets";

const { topTitle, title, linkBlocks, image } = Astro.props.data;

const imageSrc = image?.node?.sourceUrl;
const imageAlt = image?.node?.altText || "";
---

<div class="contact-meet-us">
  <Wrapper classes="contact-meet-us-wrapper">
    <div class="contact-meet-us-title">
      <h2>{topTitle}</h2>
      <h2>{title}</h2>
    </div>
    <div class="contact-meet-us-blocks">
      {linkBlocks.map((link) => {
        const iconSrc = link?.icon?.node?.sourceUrl;
        const iconAlt = link?.icon?.node?.altText || "";

        return (
          <div class="contact-meet-us-block">
            <div class="contact-meet-us-block-icon">
              <div class="contact-meet-us-block-icon-container">
                <Image
                  src={iconSrc}
                  alt={iconAlt}
                  format="webp"
                  widths={[800, 1200, 1600, 2000]}
                  sizes="100vw"
                  loading="eager"
                  inferSize={true}
                  class=""
                />
              </div>
            </div>
            <div class="contact-meet-us-block-title">
              <h3>{link.title}</h3>
            </div>
            <div
              class="contact-meet-us-block-content"
              set:html={link.content}
            />
            <div class="contact-meet-us-block-link">
              <a href={link?.buttonLink?.edges[0].node.uri}>
                {link?.buttonText}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </Wrapper>
</div>
