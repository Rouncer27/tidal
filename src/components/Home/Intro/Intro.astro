---
import Button from "../../common/shared/Button.astro";
import Wrapper from "../../common/shared/Wrapper.astro";
import "./intro.scss";

const { smallTitle, title, subTitle, content, buttonText, buttonLink } =
  Astro.props.data;
---

<div class="home-intro">
  <Wrapper>
    <div class="home-intro-title">
      <h2 class="home-intro-title-small">{smallTitle}</h2>
      <h2 class="home-intro-title-headline">{title}</h2>
      <h3 class="home-intro-title-sub" set:html={subTitle} />
    </div>
    <div class="home-intro-content" set:html={content} />
    <div class="home-intro-links">
      <Button
        target="_blank"
        rel="noopener"
        ele="a"
        btnstyle="one"
        href={buttonLink}
      >
        {buttonText}
      </Button>
    </div>
  </Wrapper>
</div>
