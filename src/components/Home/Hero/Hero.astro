---
import "./hero.scss";
import { Image } from "astro:assets";

const { heroImage } = Astro.props.data;

const imageSrc = heroImage?.node?.sourceUrl;
const imageAlt = heroImage?.node?.altText || "";

import heroWave from "../../../assets/green-wave.png";
---

<div class="hero">
  <div class="hero-background">
    <Image
      src={imageSrc}
      alt={imageAlt}
      format="webp"
      widths={[800, 1200, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      inferSize={true}
      class="hero-background-img"
    />
  </div>
  <div class="hero-graphic">
    <img src={heroWave.src} alt={"Mountain background"} />
  </div>
</div>

<script>
  // @ts-nocheck
  import { gsap } from "gsap";
  const image = document.querySelectorAll(".hero-background img");
  const tl = gsap.timeline();
  tl.add("start").from(
    image,
    { filter: "blur(100px)", duration: 2.2 },
    "start",
  );
</script>
