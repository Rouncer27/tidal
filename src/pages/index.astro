---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Home/Hero/Hero.astro";
import Intro from "../components/Home/Intro/Intro.astro";
import Choose from "../components/Home/Choose/Choose.astro";
import Stats from "../components/Home/Stats/Stats.astro";
import Support from "../components/Home/Support/Support.astro";
import Podcast from "../components/Home/Podcast/Podcast.astro";
import Testimonials from "../components/Home/Testimonials/Testimonials";
import MeetUs from "../components/Home/MeetUs/MeetUs.astro";

import { Page_Seo_Query } from "../data/page/queries";
import {
  Hero_Query,
  Intro_Query,
  Choose_Query,
  Stats_Query,
  Support_Query,
  Podcast_Query,
  Meet_Us_Query,
} from "../data/home/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query homePageQuery {
		    page(id: "/", idType: URI) {
          		${Page_Seo_Query}
            	homePage {
              		${Hero_Query}
                  ${Intro_Query}
                  ${Choose_Query}
                  ${Stats_Query}
                  ${Support_Query}
                  ${Podcast_Query}
                  ${Meet_Us_Query}
            	}
          	}

           testimonials(first: 9999999) {
            edges {
              node {
                title
                testimonialPost {
                  testimonialQuote 
                }
              }
            }
          } 
        }
	  `,
  }),
});

const {
  data: {
    page: { seoMetaTags, homePage },
    testimonials: { edges: testimonials },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
  isHome={true}
>
  <Hero data={homePage.hero} />
  <Intro data={homePage.intro} />
  <Choose data={homePage.choose} />
  <Stats data={homePage.stats} />
  <Support data={homePage.support} />
  <Podcast data={homePage.podcast} />
  <Testimonials client:only="react" testimonials={testimonials} />
  <MeetUs data={homePage.meetUs} />
</Layout>
