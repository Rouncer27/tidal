---
import Layout from "../layouts/Layout.astro";
import PodcastHero from "../components/PodcastTemp/PodcastHero/PodcastHero.astro";
import PodcastIntro from "../components/PodcastTemp/PodcastIntro/PodcastIntro.astro";

import { Page_Seo_Query } from "../data/page/queries";
import {
  Podcast_Hero_Query,
  Podcast_Intro_Query,
} from "../data/podcast/queries";

// 2️⃣ Get the actual page data by slug
const { uri } = Astro.params;

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query podcastTempQuery($slug: ID!) {
			page(id: $slug, idType: URI) {
				${Page_Seo_Query}
        template {
            ... on Template_Podcast {
            templateName
            podcastTemplate {
              ${Podcast_Hero_Query}
              ${Podcast_Intro_Query}
            }
          }                 
        }
			}
		}
	`,
    variables: { slug: `${uri}` },
  }),
});

const {
  data: {
    page: {
      seoMetaTags,
      template: { podcastTemplate },
    },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
  isHome={true}
>
  <PodcastHero data={podcastTemplate.podcastHero} />
  <PodcastIntro data={podcastTemplate.podcastIntro} />
</Layout>
