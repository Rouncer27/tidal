---
import Layout from "../layouts/Layout.astro";
import ContactHero from "../components/ContactTemp/PodcastHero/ContactHero.astro";
import ContactIntro from "../components/ContactTemp/ContactIntro/ContactIntro.astro";
import MeetUs from "../components/ContactTemp/MeetUs/MeetUs.astro";
import ContactFormDisplay from "../components/ContactTemp/ContactFormDisplay/ContactFormDisplay.astro";

import { Page_Seo_Query } from "../data/page/queries";
import {
  Contact_Hero_Query,
  Contact_Intro_Query,
  Meet_Us_Query,
} from "../data/contact/queries";

// 2️⃣ Get the actual page data by slug
const { uri } = Astro.params;

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query contactTempQuery($slug: ID!) {
			page(id: $slug, idType: URI) {
				${Page_Seo_Query}
        template {
            ... on Template_Contact {
            templateName
            contactTemplate {
              ${Contact_Hero_Query}
              ${Contact_Intro_Query}
              ${Meet_Us_Query}
            }
          }                 
        }
			}
		}
	`,
    variables: { slug: `${uri}` },
  }),
});

const {
  data: {
    page: {
      seoMetaTags,
      template: { contactTemplate },
    },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
  isHome={true}
>
  <ContactHero data={contactTemplate.contactHero} />
  <ContactIntro data={contactTemplate.contactIntro} />
  <MeetUs data={contactTemplate.meetUs} />
  <ContactFormDisplay />
</Layout>
